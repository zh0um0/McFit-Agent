# 统一换行符，避免 Windows/macOS/Linux 协作者互相看到「整个文件被修改」
# 默认：仓库内统一存 LF
* text=auto eol=lf

# 脚本保持 LF，否则 bash 在 Windows 上可能无法执行
*.sh text eol=lf
*.bat text eol=crlf     # Windows 批处理必须是 CRLF
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
*.woff binary
*.woff2 binary