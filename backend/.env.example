# ---- 应用 ----
DEBUG=true

# ---- 数据库 ----
# 默认SQLite 零配置（保证「克隆即跑」）。
# 切换 Postgres：装 psycopg[binary]（已在 requirements）后改这一行即可，代码零改动。
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mcfit

# ---- 认证 ----
# 生产环境必须改；生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 敏感字段落库加密 ----
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 不填则自动生成到 backend/.local_key（已gitignore）
# FIELD_ENCRYPTION_KEY=

# ---- 隐私开关 ----
# false = 身体数据仅本地存储，不做任何云端同步（默认，符合PRD 隐私口径）
CLOUD_SYNC_ENABLED=false

# ---- 麦当劳官方 MCP（选填）----
# 不填也能完整跑主流程（内置种子菜单 27 条）；填了可同步官方真实营养数据
# 获取 Token：见 https://github.com/M-China/mcd-mcp-server
# 注意：Token 切勿提交到 Git（.env 已在 .gitignore 中）
# MCP_TOKEN=your_mcp_token_here

# ---- 官方数据同步范围 ----
# true  = 每类精选 5 个（共 25 条），适合演示（默认）
# false = 落库官方全部 160 条，适合开发调试
MCD_PICKED_ONLY=true